#!/bin/bash
source install.env
set -e #stop the script if there are errors

sudo apt-get update  # To get the latest package lists

#Create necessary directories with appropriate permissions
sudo mkdir -p --mode=0755 /usr/share/keyrings # Ensure the keyring directory exists
sudo mkdir -p ~/.local/share/applications #create directory for application shortcuts if it doesn't exist
mkdir -p --mode=0755 /home/ian/.local/bin # Ensure the local binary directory exists with correct user permissions

#Add Additional Repositories
sudo apt-get install -y curl #Enable curl required for tailscale repositories
curl -fsSL https://pkgs.tailscale.com/stable/ubuntu/$(lsb_release -cs).gpg | sudo tee /usr/share/keyrings/tailscale-archive-keyring.gpg >/dev/null
curl -fsSL https://pkgs.tailscale.com/stable/ubuntu/$(lsb_release -cs).list | sudo tee /etc/apt/sources.list.d/tailscale.list >/dev/null
curl -fsSL https://google.com | sudo gpg --dearmor -o /usr/share/keyrings/google-chrome.gpg # Download Google's official signing key to the expected path
sudo cp ~/software-install/custom-chrome.sources /etc/apt/sources.list.d/ # Copy custom config file into place (Google will ignore and never overwrite this filename!)

#Get Updates
sudo apt-get update  # To get the latest package lists including the added repositories

#Install SNAP Packages
sudo snap install nordvpn
sudo snap install ykman #Yubikey manager for configuring the Yubikey and setting up 2FA

#Enable Flatpak apps to be installed
sudo apt-get install -y flatpak gnome-software-plugin-flatpak # 1. Install Flatpak and the Gnome Software center plugin
sudo flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo # 2. Add the official Flathub repository system-wide

#Enable Python PIP packages to be installed 
sudo apt-get install -y python3-pip #needed for pipx and some python apps, pipx is used to install python apps in isolated environments so they don't interfere with each other or the system python installation
sudo apt-get install -y pipx #new way to install isolated from system
pipx ensurepath #make sure the directory where pipx installs apps is added to the shell’s PATH

#Install Flatpak Packages
flatpak install -y flathub org.keepassxc.KeePassXC
flatpak install -y flathub com.mattjakeman.ExtensionManager #Enable and manage Gnome shell extensions
flatpak install -y flathub com.yubico.yubioath #Yubikey Authenticator with desktop integration and QR code scanning for 2FA setup
flatpak install -y flathub io.gitlab.Goodvibes #radio player for streaming online radio stations

#Install From Ubuntu Repo
sudo apt-get install -y synaptic #GUI package manager and app installer
sudo apt-get install -y gufw #Fireweall GUI
sudo DEBIAN_FRONTEND=noninteractive apt-get -y install ubuntu-restricted-extras #install non-interactive for MS Fonts and includes Lame encoder
sudo apt-get install -y nautilus-admin #Admin permissions extension for file manager
sudo apt-get install -y git
sudo apt-get install -y lm-sensors #Module to read the CPU core temperatures
sudo apt-get install -y printer-driver-gutenprint #MXG3650s printer driver
sudo apt-get install -y libsane-common #Common Scanner library, should already be installed
sudo apt-get install -y intel-gpu-tools #Run intel_gpu_top to check vaapi use
sudo apt-get install -y intel-media-va-driver-non-free #faster intel quicksync version of the Vaapi driver for intel UHD620 graphic card
sudo apt-get install -y vainfo #Run vainfo to check that vaapi driver is installed
sudo apt-get install -y gnome-tweaks
sudo apt-get install -y clamav #Command line Virus scanning. sudo freshclam then clamscan -r -i --exclude-dir="^/sys" --exclude-dir="^/var/lib/flatpak" --bell /
sudo apt-get install -y libfuse2t64 #needed for appimage software to run
sudo apt-get install -y fzf #fuzzy search and history for BASH Terminal
sudo apt-get install -y pcscd #needed for yubikey PIV gration
sudo apt-get install -y libpam-u2f #needed for yubikey sudo authentication
sudo apt-get install -y btop #Performance monitoring TUI tool
sudo apt-get install -y tailscale #Install Tailscale (official APT repo install)
sudo apt-get install -y ubuntu-pro-client #Install Ubuntu Pro client for extended security updates
sudo apt-get install -y f3 #verification checker for SD cards
sudo DEBIAN_FRONTEND=noninteractive apt-get install -y google-chrome-stable # Google Chrome (Resilient Manual Config)

#Download and intsall deb Files, Clean then Delete

# Install Dropbox
sudo DEBIAN_FRONTEND=noninteractive apt-get install -y nautilus-dropbox #Install Dropbox from the official .deb package to ensure the latest version is installed
dropbox start -i & #Start Dropbox installation in the background, this will prompt the user to link their Dropbox account

#NordVPN Snap Setup
sudo groupadd nordvpn
sudo usermod -aG nordvpn $USER
sudo snap connect nordvpn:network-control
sudo snap connect nordvpn:network-observe
sudo snap connect nordvpn:firewall-control
sudo snap connect nordvpn:login-session-observe
sudo snap connect nordvpn:system-observe
sudo snap connect nordvpn:hardware-observe
sudo nordvpn login --token $T470NORD
sudo nordvpn set lan-discovery enable #alternative to whitelisting the IP range 192.168.8.0/24
sudo nordvpn set autoconnect on london #autoconnect to London UK on startup
sudo nordvpn set tpl on #set threat protection lite to on

#Install Python packages

#Copy Configuration Files
sudo cp ~/stations.xml ~/.var/app/io.gitlab.Goodvibes/data/goodvibes/ #Goodvibes radio station list


# Enable ThinkPad Battery Protection (Preservation Mode via gnome UI settings) - This is a one-time command to enable the feature, after which it can be controlled via the gnome settings UI. The command below enables the feature and sets the charge threshold to 80% for battery preservation.
dbus-send --system --print-reply --dest=org.freedesktop.UPower /org/freedesktop/UPower/devices/battery_BAT0 org.freedesktop.UPower.Device.EnableChargeThreshold boolean:true

#SNAP overrides

# --- User Profile Customization ---
sudo install -m 0644 -o root -g root ~/software-install/ian.png /var/lib/AccountsService/icons/ian.png # 1. Safely place the icon file with root ownership and universal read permissions
sudo install -m 0644 -o root -g root ~/software-install/accounts-user-ian.conf /var/lib/AccountsService/users/ian # 2. Safely place the user metadata file in the configuration path

#Configure application packages
sudo sed -i 's/^Checks.*/Checks 0/' /etc/clamav/freshclam.conf #Disable automatic updates of clamav change checks=24 to checks=0

#Remove problematic or conflicting packages

#Setup Services to start on Boot
sudo ufw enable #Enable Firewall

#Turn Ubuntu Livepatch on - If on an LTS release
sudo ua attach $LIVEPATCH_TOKEN
sudo ua enable livepatch

#set fingerprint login preferences password at login and fingerprint and yubikey to sudo once logged in
sudo sed -i 's/^\s*auth\s\+\[success=.*pam_fprintd\.so/#&/' /etc/pam.d/common-auth
sudo grep -q 'pam_u2f.so' /etc/pam.d/sudo || sudo sed -i '1a auth    sufficient      pam_u2f.so      cue [cue_prompt="Tap the Yubikey to Sudo"]' /etc/pam.d/sudo
sudo grep -q 'pam_fprintd.so' /etc/pam.d/sudo || sudo sed -i '2a auth    sufficient      pam_fprintd.so' /etc/pam.d/sudo

#Set up Gnome Extensions need to be run as user not root
gnome-extensions disable ubuntu-dock@ubuntu.com #Disable Ubuntu dock on LHS of screen
gnome-extensions disable ding@rastersoft.com #disable the Home folder on desktop which causes occasional crashes of gjs
# --- GNOME Extension: Bing Wallpaper Changer ---
sudo wget -O /tmp/bing.zip "https://extensions.gnome.org/download-extension/BingWallpaper@ineffable-gmail.com.shell-extension.zip?shell_version=99.99.9"
gnome-extensions install /tmp/bing.zip
gnome-extensions enable BingWallpaper@ineffable-gmail.com
sudo rm -f /tmp/bing.zip
#Gnome tweaks settings
gsettings set org.gnome.desktop.interface show-battery-percentage true #show battery percentage in top bar
gsettings set org.gnome.desktop.interface scaling-factor 1 #set display scaling to 100% (integer values only, so text may be small on high res displays)
gsettings set org.gnome.desktop.interface text-scaling-factor 1.25 # set text scaling to 125% for better readability on high res displays

#Cleanup and update
sudo apt-get update
sudo apt-get upgrade -y
sudo apt-get autoremove -y
sudo apt-get clean

#MS Money Setup - has user interaction to select the installation directory
unzip -q ~/software-install/msmoneysetup_Linux_FullInstall_*.zip -d ~/software-install/ # 1. Unzip the setup files to the software-install directory
mv ~/software-install/msmoneysetup/* ~/msmoneysetup/ # 2. Move the unzipped setup files to the user's home directory for easier access
cd ~/msmoneysetup # 4. Change into the directory
chmod +x Install.sh # 5. Explicitly force the install script to be executable
./Install.sh # 6. Execute the setup script

echo 'Reboot now to apply all changes and updates, including the new kernel if one was installed. After rebooting, check that everything is working correctly'

#Restart the computer:)
sudo reboot

exit 0 #Exit the script, shouldn't get here
